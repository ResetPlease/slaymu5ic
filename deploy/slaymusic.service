[Unit]
Description=Slaymusic audio editor
After=network.target

[Service]
Type=simple
User=slaymusic
Group=slaymusic
WorkingDirectory=/opt/slaymusic/current
EnvironmentFile=/etc/slaymusic.env
EnvironmentFile=-/opt/slaymusic/current/release.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/slaymusic/current/.venv/bin/python -m uvicorn app_final:app --host 127.0.0.1 --port 8093 --workers 1 --no-access-log --timeout-keep-alive 5 --limit-concurrency 24
Restart=on-failure
RestartSec=3
TimeoutStopSec=70
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=768M
MemorySwapMax=0
CPUQuota=150%
TasksMax=32
LimitCORE=0
UMask=0077

[Install]
WantedBy=multi-user.target
